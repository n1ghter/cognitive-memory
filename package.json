{
  "name": "@cemised/cognitive-memory",
  "version": "2.0.0",
  "description": "Vendor-neutral, Markdown-first, zero-Ollama hybrid (SQLite FTS5 BM25 + optional sqlite-vec RRF) MCP memory engine.",
  "main": "dist/index.js",
  "bin": {
    "cognitive-memory": "./dist/index.js"
  },
  "type": "module",
  "author": "Eduards Čemis <https://www.linkedin.com/in/cemised/>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n1ghter/cognitive-memory.git"
  },
  "keywords": [
    "mcp",
    "ai",
    "memory",
    "sqlite",
    "fts5",
    "bm25",
    "hybrid-search",
    "obsidian",
    "agent",
    "rag"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "start:sse": "node dist/index.js --sse",
    "dashboard": "node dist/index.js dashboard",
    "ui": "node dist/index.js ui",
    "dev": "ts-node-esm src/index.ts",
    "seed": "npx tsx scripts/seed-test-data.ts",
    "eval": "npx tsx evals/run.ts",
    "eval:ci": "npx tsx evals/run.ts --embedder hash",
    "eval:check": "npx tsx evals/run.ts --embedder hash --mode compare --check-baseline",
    "verify": "pnpm exec biome ci . && pnpm exec tsc -b && pnpm build && pnpm test && pnpm --dir ui build && pnpm --dir ui test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "version": "npx tsx scripts/update-changelog.ts && git add CHANGELOG.md",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^5.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sqlite-vec",
      "esbuild"
    ]
  },
  "license": "Apache-2.0"
}
