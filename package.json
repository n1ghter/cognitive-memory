{
  "name": "@cemised/cognitive-memory",
  "version": "1.5.4",
  "description": "An autonomous graph-vector memory engine powered by SQLite and Ollama.",
  "main": "dist/index.js",
  "bin": {
    "cognitive-memory": "./dist/index.js"
  },
  "type": "module",
  "author": "Eduards Čemis <https://www.linkedin.com/in/cemised/>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n1ghter/cognitive-memory.git"
  },
  "keywords": [
    "mcp",
    "ai",
    "memory",
    "sqlite",
    "obsidian",
    "agent",
    "rag"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dashboard": "node dist/index.js dashboard",
    "ui": "node dist/index.js ui",
    "dev": "ts-node-esm src/index.ts",
    "seed": "npx tsx scripts/seed-test-data.ts",
    "gitnexus": "gitnexus analyze --skip-skills --skip-agents-md",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "version": "node scripts/update-changelog.js && git add CHANGELOG.md",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,md}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "sqlite-vec": "^0.1.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.2",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "gitnexus": "^1.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "@ladybugdb/core",
      "sqlite-vec",
      "esbuild"
    ]
  },
  "license": "Apache-2.0"
}
